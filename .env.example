# Copy to .env.local and fill in. Nothing here is required except MONGODB_URI
# and AUTH_SECRET (local dev falls back to sensible defaults for the rest).

# ----------------------------
# remember to add RESEND_API_KEY, BANK_ACCOUNT_NUMBER, CHECKOUT_COD_ONLY
# EASYPAISA_ACCOUNT_TITLE to vercel env variables for production deployment
# ----------------------------

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/noor-nursery

# ── Auth ──────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Guards admin/customer sessions (middleware).
AUTH_SECRET=generate-a-32-char-or-longer-random-secret

# ── Email (optional — order emails are skipped when unset) ────────────────
RESEND_API_KEY=
EMAIL_FROM=Noor Nursery <orders@yourdomain.com>

# ── Store (public, inlined at build time) ─────────────────────────────────
NEXT_PUBLIC_CURRENCY=PKR
NEXT_PUBLIC_STORE_NAME=Noor Nursery
NEXT_PUBLIC_STORE_PHONE=03001234567
NEXT_PUBLIC_STORE_EMAIL=orders@noornursery.pk
NEXT_PUBLIC_STORE_ADDRESS=Lahore, Pakistan

# ── Delivery (optional; Admin → Settings overrides these) ─────────────────
DEFAULT_DELIVERY_FEE=250
FREE_DELIVERY_THRESHOLD=2500

# ── Payments ──────────────────────────────────────────────────────────────
# Checkout supports exactly two methods: Cash on Delivery + EasyPaisa
# (customer sends money manually, seller confirms the TrxID in admin).
# EasyPaisa account title/number live in Admin → Settings (database); these
# env vars are only the fallback used before the first save.
EASYPAISA_ACCOUNT_TITLE=
EASYPAISA_ACCOUNT_NUMBER=
# Set to true to show Cash on Delivery only and hide EasyPaisa at checkout.
CHECKOUT_COD_ONLY=false

# Bank details below are kept for admin records only — bank transfer is not
# offered at checkout.
BANK_ACCOUNT_TITLE=Noor Nursery
BANK_ACCOUNT_NUMBER=
BANK_NAME=HBL
BANK_BRANCH=Lahore Main

# ── Images (optional; admin can paste image URLs instead) ─────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed only (npm run seed) — not required on Vercel for day-to-day admin login
ADMIN_BOOTSTRAP_EMAIL=admin@noornursery.pk
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-seeding
