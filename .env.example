# Copy to .env.local and fill in.
#
# Production (Vercel / host) MUST set at least:
#   MONGODB_URI, AUTH_SECRET, NEXT_PUBLIC_APP_URL
# Recommended: RESEND_API_KEY, EMAIL_FROM, CLOUDINARY_*, JazzCash via Admin Settings

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/noor-nursery

# ── Auth ──────────────────────────────────────────────────────────────────
# Must be at least 32 characters in production.
AUTH_SECRET=generate-a-32-char-or-longer-random-secret

# Optional: detailed /api/health checks via header x-health-secret
# HEALTH_CHECK_SECRET=

# ── Email (Resend — order/contact/reset skipped or fail closed when unset) ─
RESEND_API_KEY=
EMAIL_FROM=Noor Nursery <noreply@noornursery.com>
EMAIL_REPLY_TO=support@noornursery.com
CONTACT_TO=support@noornursery.com

# ── Store (public, inlined at build time) ─────────────────────────────────
NEXT_PUBLIC_CURRENCY=PKR
NEXT_PUBLIC_STORE_NAME=Noor Nursery
NEXT_PUBLIC_STORE_PHONE=03001234567
NEXT_PUBLIC_STORE_EMAIL=support@noornursery.com
NEXT_PUBLIC_STORE_ADDRESS=Karachi, Pakistan

# ── Delivery (optional; Admin → Settings overrides these) ─────────────────
DEFAULT_DELIVERY_FEE=250
FREE_DELIVERY_THRESHOLD=2500

# ── Payments ──────────────────────────────────────────────────────────────
# Checkout: Cash on Delivery + JazzCash Send Money (manual TID).
# Do NOT set JAZZCASH_MERCHANT_* — merchant gateway is disabled.
#
# Prefer Admin → Settings for the JazzCash wallet. Env is fallback only:
JAZZCASH_ACCOUNT_TITLE=
JAZZCASH_ACCOUNT_NUMBER=
#
# Set true to show Cash on Delivery only (hide JazzCash):
CHECKOUT_COD_ONLY=false

# Bank details — admin records only (not offered at checkout)
BANK_ACCOUNT_TITLE=Noor Nursery
BANK_ACCOUNT_NUMBER=
BANK_NAME=HBL
BANK_BRANCH=

# ── Images (Admin uploads; required for site/product image upload UI) ─────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed only (npm run seed) — change before first seed
ADMIN_BOOTSTRAP_EMAIL=admin@noornursery.pk
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-seeding
